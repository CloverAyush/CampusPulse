# Copy to .env and fill in. Never commit the real .env.

# development | staging | production
ENVIRONMENT=development

DATABASE_URL=sqlite:///./campuspulse.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg://campuspulse:CHANGE_ME@localhost:5432/campuspulse

# REQUIRED, no default. The app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated. Must be https and must not be "*" when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
LOG_JSON=true

LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5
WRITE_RATE_LIMIT_PER_MINUTE=30

# Attachment links students and handlers may paste. Leave hosts empty to allow any
# https host, or list your own domains to restrict it.
ALLOWED_ATTACHMENT_SCHEMES=https
ALLOWED_ATTACHMENT_HOSTS=
